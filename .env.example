# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-32-byte-string   # generate: openssl rand -base64 32
ALLOWED_EMAIL_DOMAIN=prialto.com                        # restrict SSO login to this domain

# Set to "false" once real credentials below are filled in and a sync has run.
USE_MOCK_DATA=true

# --- Database (Postgres — for local dev, run `docker compose up db`) ---
DATABASE_URL="postgresql://prialto:prialto@localhost:5432/prialto_finance"

# --- SSO (pick one or both — see docs/CREDENTIALS.md is NOT where these come from;
#     these come from Google Cloud Console / Entra ID, not the 4 data sources) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Salesforce (see docs/CREDENTIALS.md #1) ---
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=

# --- QuickBooks Online (see docs/CREDENTIALS.md #2) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox   # "production" once verified

# --- Time Doctor (see docs/CREDENTIALS.md #3) ---
TIMEDOCTOR_CLIENT_ID=
TIMEDOCTOR_CLIENT_SECRET=
TIMEDOCTOR_COMPANY_ID=
